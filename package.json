{
  "name": "dsh-quote-to-composer",
  "version": "0.9.2",
  "description": "Select text anywhere in DeepSeek Harness, click the pill next to the pointer, and the quote lands in the composer as a tiny chip — hover it to read the full quote. 选中文字 → 鼠标旁「引用」胶囊 → 输入框里的迷你「引用」圆角条；悬停显示被引用内容。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "quote",
    "composer",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.1.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/INSTALL-windows.md",
    "docs/INSTALL-macOS.md",
    "screenshots.json",
    "docs/screenshot-pill.png",
    "docs/screenshot-chip.png",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bigbigman-001/dsh-quote-to-composer.git"
  },
  "homepage": "https://github.com/bigbigman-001/dsh-quote-to-composer#readme",
  "bugs": {
    "url": "https://github.com/bigbigman-001/dsh-quote-to-composer/issues"
  }
}
